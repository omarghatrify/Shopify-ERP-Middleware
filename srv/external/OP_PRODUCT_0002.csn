{
 "meta": {
  "creator": "cds-dk 9.7.2"
 },
 "$version": "2.0",
 "definitions": {
  "OP_PRODUCT_0002.SAP__Message": {
   "kind": "type",
   "@cds.external": true,
   "elements": {
    "code": {
     "type": "cds.String",
     "notNull": true
    },
    "message": {
     "type": "cds.String",
     "notNull": true
    },
    "target": {
     "type": "cds.String"
    },
    "additionalTargets": {
     "items": {
      "type": "cds.String",
      "notNull": true
     }
    },
    "transition": {
     "type": "cds.Boolean",
     "notNull": true
    },
    "numericSeverity": {
     "type": "cds.Integer",
     "@odata.Type": "Edm.Byte",
     "notNull": true
    },
    "longtextUrl": {
     "type": "cds.String"
    }
   }
  },
  "OP_PRODUCT_0002": {
   "kind": "service",
   "@cds.external": true,
   "@CodeList.UnitsOfMeasure.Url": "../../../../default/iwbep/common/0001/$metadata",
   "@CodeList.UnitsOfMeasure.CollectionPath": "UnitsOfMeasure",
   "@CodeList.CurrencyCodes.Url": "../../../../default/iwbep/common/0001/$metadata",
   "@CodeList.CurrencyCodes.CollectionPath": "Currencies",
   "@Aggregation.ApplySupported.Transformations": [
    "aggregate",
    "groupby",
    "filter"
   ],
   "@Aggregation.ApplySupported.Rollup": {
    "#": "None"
   },
   "@Common.ApplyMultiUnitBehaviorForSortingAndFiltering": true,
   "@Capabilities.FilterFunctions": [
    "eq",
    "ne",
    "gt",
    "ge",
    "lt",
    "le",
    "and",
    "or",
    "contains",
    "startswith",
    "endswith",
    "any",
    "all"
   ],
   "@Capabilities.SupportedFormats": [
    "application/json",
    "application/pdf"
   ],
   "@PDF.Features.DocumentDescriptionReference": "../../../../default/iwbep/common/0001/$metadata",
   "@PDF.Features.DocumentDescriptionCollection": "MyDocumentDescriptions",
   "@PDF.Features.ArchiveFormat": true,
   "@PDF.Features.Border": true,
   "@PDF.Features.CoverPage": true,
   "@PDF.Features.FitToPage": true,
   "@PDF.Features.FontName": true,
   "@PDF.Features.FontSize": true,
   "@PDF.Features.Margin": true,
   "@PDF.Features.Padding": true,
   "@PDF.Features.Signature": true,
   "@PDF.Features.HeaderFooter": true,
   "@PDF.Features.ResultSizeDefault": 20000,
   "@PDF.Features.ResultSizeMaximum": 20000,
   "@Capabilities.KeyAsSegmentSupported": true,
   "@Capabilities.AsynchronousRequestsSupported": true
  },
  "OP_PRODUCT_0002.ProdSalesDeliverySalesTax": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "Product": {
     "key": true,
     "type": "cds.String",
     "length": 40,
     "notNull": true,
     "@Core.Computed": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Product",
     "@Common.QuickInfo": "Product Number"
    },
    "Country": {
     "key": true,
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Core.Immutable": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Departure Ctry/Reg.",
     "@Common.Heading": "DeCR",
     "@Common.QuickInfo": "Departure Country/Region (from which the goods are sent)"
    },
    "ProductSalesTaxCategory": {
     "key": true,
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Core.Immutable": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Tax Condition Type",
     "@Common.Heading": "TxCT",
     "@Common.QuickInfo": "Tax Condition Type (Sales Tax, Value-Added Tax,...)"
    },
    "ProductSalesOrg": {
     "key": true,
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Core.Computed": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Sales Organization",
     "@Common.Heading": "SOrg."
    },
    "ProductDistributionChnl": {
     "key": true,
     "type": "cds.String",
     "length": 2,
     "notNull": true,
     "@Core.Computed": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Distribution Channel",
     "@Common.Heading": "DChl"
    },
    "ProductTaxClassification": {
     "type": "cds.String",
     "length": 1,
     "notNull": true
    },
    "SAP__Messages": {
     "items": {
      "type": "OP_PRODUCT_0002.SAP__Message",
      "notNull": true
     }
    },
    "_Product": {
     "type": "cds.Association",
     "target": "OP_PRODUCT_0002.Product",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "_Product",
        "Product"
       ]
      },
      "=",
      {
       "ref": [
        "Product"
       ]
      }
     ]
    },
    "_ProductSalesDelivery": {
     "type": "cds.Association",
     "target": "OP_PRODUCT_0002.ProductSalesDelivery",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "_ProductSalesDelivery",
        "ProductDistributionChnl"
       ]
      },
      "=",
      {
       "ref": [
        "ProductDistributionChnl"
       ]
      }
     ]
    }
   },
   "@Common.Label": "Product Sales Delivery Sales Tax",
   "@Common.Messages": {
    "=": "SAP__Messages"
   },
   "@Capabilities.SearchRestrictions.Searchable": false,
   "@Capabilities.InsertRestrictions.Insertable": false,
   "@Capabilities.DeleteRestrictions.Deletable": false,
   "@Core.OptimisticConcurrency": [
    "_Product/LastChangeDateTime"
   ],
   "@Capabilities.UpdateRestrictions.QueryOptions.SelectSupported": true
  },
  "OP_PRODUCT_0002.Product": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "Product": {
     "key": true,
     "type": "cds.String",
     "length": 40,
     "notNull": true,
     "@Core.Immutable": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Product",
     "@Common.QuickInfo": "Product Number"
    },
    "ProductType": {
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Common.SAPObjectNodeTypeReference": "ProductType",
     "@Common.IsUpperCase": true,
     "@Common.Label": "Product Type",
     "@Common.Heading": "PTyp"
    },
    "CreationDate": {
     "type": "cds.Date",
     "@Core.Computed": true,
     "@Common.Label": "Created On",
     "@Common.Heading": "Created"
    },
    "CreationTime": {
     "type": "cds.Time",
     "notNull": true,
     "@Core.Computed": true,
     "@Common.Label": "Created At Time",
     "@Common.QuickInfo": "Time of Creation"
    },
    "CreationDateTime": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@Common.Label": "Created On",
     "@Common.QuickInfo": "Product Created On"
    },
    "CreatedByUser": {
     "type": "cds.String",
     "length": 12,
     "notNull": true,
     "@Core.Computed": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Created By",
     "@Common.QuickInfo": "Name of Person Responsible for Creating the Object"
    },
    "LastChangeDate": {
     "type": "cds.Date",
     "@Core.Computed": true,
     "@Common.Label": "Last Change",
     "@Common.Heading": "Last Chg",
     "@Common.QuickInfo": "Date of Last Change"
    },
    "LastChangedByUser": {
     "type": "cds.String",
     "length": 12,
     "notNull": true,
     "@Core.Computed": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Changed By",
     "@Common.QuickInfo": "Name of Person Who Changed Object"
    },
    "IsMarkedForDeletion": {
     "type": "cds.Boolean",
     "notNull": true,
     "@Common.Label": "Marked for Deletion",
     "@Common.Heading": "D",
     "@Common.QuickInfo": "Deletion Indicator"
    },
    "CrossPlantStatus": {
     "type": "cds.String",
     "length": 2,
     "notNull": true,
     "@Common.SAPObjectNodeTypeReference": "ProductProfileCode",
     "@Common.IsUpperCase": true,
     "@Common.Label": "CrossPlantProdStatus",
     "@Common.Heading": "PS",
     "@Common.QuickInfo": "Cross-Plant Product Status"
    },
    "CrossPlantStatusValidityDate": {
     "type": "cds.Date",
     "@Common.Label": "Valid from",
     "@Common.QuickInfo": "Date from which the cross-plant material status is valid"
    },
    "ProductOldID": {
     "type": "cds.String",
     "length": 40,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Old Product Number",
     "@Common.Heading": "Old Product No."
    },
    "GrossWeight": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "notNull": true,
     "@Measures.Unit": {
      "=": "WeightUnit"
     },
     "@Measures.UNECEUnit": {
      "=": "WeightISOUnit"
     },
     "@Common.Label": "Gross Weight"
    },
    "WeightUnit": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUnit": true,
     "@Common.Label": "Unit of Weight",
     "@Common.Heading": "WUn"
    },
    "WeightISOUnit": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Unit of weight ISO",
     "@Common.Heading": "WUn",
     "@Common.QuickInfo": "Unit of weight in ISO code"
    },
    "ProductGroup": {
     "type": "cds.String",
     "length": 9,
     "notNull": true,
     "@Common.SAPObjectNodeTypeReference": "ProductGroup",
     "@Common.IsUpperCase": true,
     "@Common.Label": "Product Group",
     "@Common.Heading": "Prd Group"
    },
    "BaseUnit": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUnit": true,
     "@Common.Label": "Base Unit of Measure",
     "@Common.Heading": "BUn",
     "@Common.QuickInfo": "Base Unit of Measure - No Conversion Routine"
    },
    "BaseISOUnit": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Base unit ISO code",
     "@Common.Heading": "BUI",
     "@Common.QuickInfo": "Base unit of measure in ISO code"
    },
    "ItemCategoryGroup": {
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Common.SAPObjectNodeTypeReference": "ProductItemCategoryGroup",
     "@Common.IsUpperCase": true,
     "@Common.Label": "Gen. item cat. grp",
     "@Common.Heading": "ItCGr",
     "@Common.QuickInfo": "General item category group"
    },
    "NetWeight": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "notNull": true,
     "@Measures.Unit": {
      "=": "WeightUnit"
     },
     "@Measures.UNECEUnit": {
      "=": "WeightISOUnit"
     },
     "@Common.Label": "Net Weight"
    },
    "Division": {
     "type": "cds.String",
     "length": 2,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Division",
     "@Common.Heading": "Dv"
    },
    "VolumeUnit": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUnit": true,
     "@Common.Label": "Volume Unit",
     "@Common.Heading": "VUn"
    },
    "VolumeISOUnit": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Volume unit ISO",
     "@Common.Heading": "VUI",
     "@Common.QuickInfo": "Volume unit in ISO code"
    },
    "ProductVolume": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "notNull": true,
     "@Measures.Unit": {
      "=": "VolumeUnit"
     },
     "@Measures.UNECEUnit": {
      "=": "VolumeISOUnit"
     },
     "@Common.Label": "Volume"
    },
    "AuthorizationGroup": {
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Authorization Group",
     "@Common.Heading": "AGrp"
    },
    "ANPCode": {
     "type": "cds.String",
     "length": 9,
     "notNull": true,
     "@Common.IsDigitSequence": true,
     "@Common.Label": "ANP Code"
    },
    "SizeOrDimensionText": {
     "type": "cds.String",
     "length": 32,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Size/dimensions"
    },
    "IndustryStandardName": {
     "type": "cds.String",
     "length": 18,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Industry Std Desc.",
     "@Common.QuickInfo": "Industry Standard Description (such as ANSI or ISO)"
    },
    "ProductStandardID": {
     "type": "cds.String",
     "length": 18,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "GTIN",
     "@Common.QuickInfo": "Global Trade Item Number (EAN/UPC/GTIN)"
    },
    "InternationalArticleNumberCat": {
     "type": "cds.String",
     "length": 2,
     "notNull": true,
     "@Common.SAPObjectNodeTypeReference": "GlobalTradeItemNumberCategory",
     "@Common.IsUpperCase": true,
     "@Common.Label": "EAN Category",
     "@Common.Heading": "Ct",
     "@Common.QuickInfo": "Category of International Article Number (EAN)"
    },
    "ProductIsConfigurable": {
     "type": "cds.Boolean",
     "notNull": true,
     "@Common.Label": "Configurable",
     "@Common.Heading": "Conf.",
     "@Common.QuickInfo": "Product is Configurable"
    },
    "IsBatchManagementRequired": {
     "type": "cds.Boolean",
     "notNull": true,
     "@Common.Label": "Batch Management",
     "@Common.Heading": "BMR",
     "@Common.QuickInfo": "Batch Management Requirement Indicator"
    },
    "ExternalProductGroup": {
     "type": "cds.String",
     "length": 18,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Ext. Product Group",
     "@Common.Heading": "Ext. Product Grp",
     "@Common.QuickInfo": "External Product Group"
    },
    "CrossPlantConfigurableProduct": {
     "type": "cds.String",
     "length": 40,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Cross-plant CP",
     "@Common.QuickInfo": "Cross-Plant Configurable Product"
    },
    "SerialNoExplicitnessLevel": {
     "type": "cds.String",
     "length": 1,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Serialization level",
     "@Common.Heading": "SL",
     "@Common.QuickInfo": "Level of Explicitness for Serial Number"
    },
    "IsApprovedBatchRecordReqd": {
     "type": "cds.Boolean",
     "notNull": true,
     "@Common.Label": "Appr.Batch Recd Req.",
     "@Common.Heading": "AR",
     "@Common.QuickInfo": "Approved Batch Record Required"
    },
    "HandlingIndicator": {
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Handling Indicator",
     "@Common.Heading": "Hand.Ind."
    },
    "WarehouseProductGroup": {
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "WH Material Group",
     "@Common.Heading": "WHMatGrp",
     "@Common.QuickInfo": "Warehouse Material Group"
    },
    "WarehouseStorageCondition": {
     "type": "cds.String",
     "length": 2,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Whse Stor. Condition",
     "@Common.Heading": "Cond.",
     "@Common.QuickInfo": "Warehouse Storage Condition"
    },
    "StandardHandlingUnitType": {
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Standard HU Type"
    },
    "SerialNumberProfile": {
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Serial No. Profile",
     "@Common.QuickInfo": "Serial Number Profile"
    },
    "IsPilferable": {
     "type": "cds.Boolean",
     "notNull": true,
     "@Common.Label": "Pilferable"
    },
    "IsRelevantForHzdsSubstances": {
     "type": "cds.Boolean",
     "notNull": true,
     "@Common.Label": "Relevant for HS",
     "@Common.Heading": "Rel. for HS",
     "@Common.QuickInfo": "Relevant for Hazardous Substances"
    },
    "QuarantinePeriod": {
     "type": "cds.Decimal",
     "precision": 3,
     "notNull": true,
     "@Measures.Unit": {
      "=": "TimeUnitForQuarantinePeriod"
     },
     "@Measures.UNECEUnit": {
      "=": "QuarantinePeriodISOUnit"
     },
     "@Common.Label": "Quarant. Per.",
     "@Common.Heading": "QPer.",
     "@Common.QuickInfo": "Quarantine Period"
    },
    "TimeUnitForQuarantinePeriod": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUnit": true,
     "@Common.Label": "Time Unit",
     "@Common.Heading": "Quarantine Time Unit",
     "@Common.QuickInfo": "Time Unit for Quarantine Period"
    },
    "QuarantinePeriodISOUnit": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Time Unit",
     "@Common.Heading": "Quarantine Time Unit",
     "@Common.QuickInfo": "Time Unit for Quarantine Time in ISO Code"
    },
    "QualityInspectionGroup": {
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Quality Inspec. Grp",
     "@Common.Heading": "Quality Inspection Group",
     "@Common.QuickInfo": "Quality Inspection Group"
    },
    "HandlingUnitType": {
     "type": "cds.String",
     "length": 4,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Handling Unit Type"
    },
    "HasVariableTareWeight": {
     "type": "cds.Boolean",
     "notNull": true,
     "@Common.Label": "Varb. Tare Weight",
     "@Common.Heading": "V",
     "@Common.QuickInfo": "Variable Tare Weight"
    },
    "MaximumPackagingLength": {
     "type": "cds.Decimal",
     "precision": 15,
     "scale": 3,
     "notNull": true,
     "@Measures.Unit": {
      "=": "UnitForMaxPackagingDimensions"
     },
     "@Measures.UNECEUnit": {
      "=": "MaxPackggDimensionISOUnit"
     },
     "@Common.Label": "Max. Pack. Length",
     "@Common.QuickInfo": "Maximum Packing Length of Packaging Material"
    },
    "MaximumPackagingWidth": {
     "type": "cds.Decimal",
     "precision": 15,
     "scale": 3,
     "notNull": true,
     "@Measures.Unit": {
      "=": "UnitForMaxPackagingDimensions"
     },
     "@Measures.UNECEUnit": {
      "=": "MaxPackggDimensionISOUnit"
     },
     "@Common.Label": "Max. Pack. Width",
     "@Common.QuickInfo": "Maximum Packing Width of Packaging Material"
    },
    "MaximumPackagingHeight": {
     "type": "cds.Decimal",
     "precision": 15,
     "scale": 3,
     "notNull": true,
     "@Measures.Unit": {
      "=": "UnitForMaxPackagingDimensions"
     },
     "@Measures.UNECEUnit": {
      "=": "MaxPackggDimensionISOUnit"
     },
     "@Common.Label": "Max. Pack. Height",
     "@Common.QuickInfo": "Maximum Packing Height of Packaging Material"
    },
    "MaximumCapacity": {
     "type": "cds.Decimal",
     "precision": 15,
     "scale": 3,
     "notNull": true,
     "@Common.Label": "Maximum Capacity",
     "@Common.QuickInfo": "Maximum Allowed Capacity of Packaging Material"
    },
    "OvercapacityTolerance": {
     "type": "cds.Decimal",
     "precision": 3,
     "scale": 1,
     "notNull": true,
     "@Common.Label": "Overcapacity Toler.",
     "@Common.Heading": "OCT",
     "@Common.QuickInfo": "Overcapacity Tolerance of the Handling Unit"
    },
    "UnitForMaxPackagingDimensions": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUnit": true,
     "@Common.Label": "Unit of Measurement",
     "@Common.Heading": "UoM",
     "@Common.QuickInfo": "Unit of Measure for Maximum Packing Length/Width/Height"
    },
    "MaxPackggDimensionISOUnit": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Unit: ISO Code",
     "@Common.Heading": "Unt",
     "@Common.QuickInfo": "Unit for Maximum Packing Length/Width/Height in ISO Code"
    },
    "BaseUnitSpecificProductLength": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "notNull": true,
     "@Measures.Unit": {
      "=": "ProductMeasurementUnit"
     },
     "@Measures.UNECEUnit": {
      "=": "ProductMeasurementISOUnit"
     },
     "@Common.Label": "Length"
    },
    "BaseUnitSpecificProductWidth": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "notNull": true,
     "@Measures.Unit": {
      "=": "ProductMeasurementUnit"
     },
     "@Measures.UNECEUnit": {
      "=": "ProductMeasurementISOUnit"
     },
     "@Common.Label": "Width"
    },
    "BaseUnitSpecificProductHeight": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "notNull": true,
     "@Measures.Unit": {
      "=": "ProductMeasurementUnit"
     },
     "@Measures.UNECEUnit": {
      "=": "ProductMeasurementISOUnit"
     },
     "@Common.Label": "Height"
    },
    "ProductMeasurementUnit": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUnit": true,
     "@Common.Label": "Unit of Dimension",
     "@Common.QuickInfo": "Unit of Dimension for Length/Width/Height"
    },
    "ProductMeasurementISOUnit": {
     "type": "cds.String",
     "length": 3,
     "notNull": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Dimension unit ISO",
     "@Common.Heading": "DUI",
     "@Common.QuickInfo": "Unit for length/breadth/height in ISO code"
    },
